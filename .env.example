# EdgeShield AI — service configuration (copy to .env; defaults work out of the box)
BACKEND_PORT=4000
INFERENCE_PORT=8100
SIMULATOR_PORT=8200
FRONTEND_PORT=5173
INFERENCE_URL=http://127.0.0.1:8100
SIMULATOR_URL=http://127.0.0.1:8200
BACKEND_URL=http://127.0.0.1:4000
GLOBAL_SEED=42

# ---------------- notifications (all optional — the app runs without them) ---
# Email (Gmail SMTP — use an App Password, see README "Notifications setup")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# default alert recipients, comma-separated (also editable in the dashboard)
EMAIL_TO=

# SMS (Twilio — if unset, SMS is simulated and logged, never crashes)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# default alert phone numbers, comma-separated, E.164 format (+91...)
ALERT_PHONE=

# link used inside notification emails
DASHBOARD_URL=http://localhost:5173
